{
  "name": "react-sync-board",
  "version": "1.3.0",
  "description": "React-sync-board is a board for react",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/react-sync-board.umd.cjs",
  "module": "./dist/react-sync-board.js",
  "exports": {
    ".": {
      "import": "./dist/react-sync-board.js",
      "require": "./dist/react-sync-board.umd.cjs"
    }
  },
  "author": "Jérémie Pardou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jrmi/react-sync-board"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:website": "tsc && BUILD_WEBSITE='true' vite build",
    "watch": "tsc && vite build --watch",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "test": "vitest run",
    "version": "git changelog -n -t $npm_package_version && git add CHANGELOG.md"
  },
  "peerDependencies": {
    "react": ">= 18",
    "react-dom": ">= 18"
  },
  "dependencies": {
    "@react-hookz/web": "^26.1.0",
    "color2k": "^2.0.4",
    "fast-deep-equal": "^3.1.3",
    "goober": "^2.1.19",
    "nanoid": "^6.0.1",
    "npm-cli": "^0.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@scripters/use-socket.io": "github:jrmi/use-socket.io#updated-v2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rc-slider": "^11.1.9",
    "react": "^19.3.0",
    "react-color": "^2.19.3",
    "react-dom": "^19.3.0",
    "react-final-form": "^7.0.1",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "use-sync-external-store": "^1.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wire.io": "^3.3.3"
  }
}
